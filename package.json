{
  "name": "ausafj-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio — static MDX content in git, a serverless API off the critical path, and a CLI that manages both.",
  "workspaces": [
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/schema/tsconfig.json --noEmit && tsc -p packages/commands/tsconfig.json --noEmit && tsc -p cli/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx cli/bin/ausaf.ts validate",
    "ausaf": "tsx cli/bin/ausaf.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ausaf/commands": "*",
    "@ausaf/schema": "*",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.28.0",
    "mongoose": "^9.9.1",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
