{
  "permissions": {
    "allow": [
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Read(//d/utils/**)",
      "Read(//d//**)",
      "mcp__ide__getDiagnostics"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Technyx/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Technyx/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}
