# Copy to .env.local and fill in. Never commit the filled version.
# Every new secret added to the codebase must also be added here.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://example.dev

# --- MongoDB Atlas (dynamic data only: views, guestbook, contact, audit) ---
# Separate databases for preview and production deployments.
MONGODB_URI=
MONGODB_DB=

# --- GitHub OAuth (guestbook sign-in) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=

# --- Contact form email dispatch ---
CONTACT_TO_EMAIL=
RESEND_API_KEY=

# --- CLI ---
# Bearer token the `ausaf` CLI presents to /api/cli/*. Long random string.
CLI_API_TOKEN=
# Used by `ausaf deploy --status`.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
